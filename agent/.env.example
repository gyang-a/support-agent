# DeepSeek Chat API（必填）
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_INITIAL_DELAY=1
DEEPSEEK_RETRY_MULTIPLIER=2
DEEPSEEK_RETRY_MAX_DELAY=8
# 主模型重试耗尽后切换；留空可关闭。也可为备用供应商单独配置地址和 Key。
DEEPSEEK_FALLBACK_MODEL=deepseek-chat
# DEEPSEEK_FALLBACK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_FALLBACK_API_KEY=replace-with-fallback-api-key

# MySQL：LangGraph Checkpoint、会话消息和结构化用户偏好
# 先创建 digital_agent 数据库；密码中的特殊字符需要 URL 编码。
MYSQL_URL=mysql+asyncmy://root:password@127.0.0.1:3306/digital_agent?charset=utf8mb4
MYSQL_ECHO=false
PREFERENCE_EXTRACTION_INTERVAL_SECONDS=7200
PREFERENCE_EXTRACTION_USER_LIMIT=100
PREFERENCE_EXTRACTION_MESSAGE_LIMIT=200

# 硅基流动 Embedding；API Key 仅保存在后端
EMBEDDING_API_KEY=replace-with-your-siliconflow-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSION=1024
# 当前知识集合使用此后缀；部署快照已直接迁入旧 1024 维向量，无需重新入库。
EMBEDDING_NAMESPACE=sf_qwen3_06b_v1

# 硅基流动重排，无需下载 Hugging Face 权重
RERANKER_PROVIDER=siliconflow
RERANKER_API_KEY=replace-with-your-siliconflow-key
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT=15
RERANKER_ALLOW_HEURISTIC_FALLBACK=true

AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
# 总尝试次数（含首次请求）、单次超时秒数、熔断冷却秒数
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_TIMEOUT=30
EMBEDDING_CIRCUIT_COOLDOWN=60
MILVUS_HOST=localhost
MILVUS_PORT=19530
# MILVUS_API_KEY=
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.96
SEMANTIC_CACHE_TTL_SECONDS=604800
SEMANTIC_CACHE_KNOWLEDGE_VERSION=digital-support-v1

LOG_LEVEL=INFO
