# Copy to .env in the repository root for Docker Compose.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
SILICONFLOW_API_KEY=replace-with-your-siliconflow-key

# Generate different random hexadecimal passwords; MYSQL_PASSWORD is used in a URL.
MYSQL_PASSWORD=replace-with-random-hex-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex-password
MINIO_USER=supportminio
MINIO_PASSWORD=replace-with-another-random-password

HTTP_PORT=80
# Set true only after HTTPS is configured; HTTP access requires false.
AUTH_COOKIE_SECURE=false
